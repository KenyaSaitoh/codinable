<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
         version="6.1">

    <!-- XHTML のコメントを応答の HTML に出さない -->
    <context-param>
        <param-name>jakarta.faces.FACELETS_SKIP_COMMENTS</param-name>
        <param-value>true</param-value>
    </context-param>

    <servlet>
        <servlet-name>FacesServlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>FacesServlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>
    <welcome-file-list>
        <welcome-file>employees/list.xhtml</welcome-file>
    </welcome-file-list>

    <!-- 社員の画面は認証済みの利用者なら誰でも、削除の画面は ADMIN だけ -->
    <!-- login.xhtml と画面の CSS（/jakarta.faces.resource/*）には制約を書かない -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>employee-pages</web-resource-name>
            <url-pattern>/employees/*</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>**</role-name>
        </auth-constraint>
    </security-constraint>
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>employee-delete</web-resource-name>
            <url-pattern>/employees/delete.xhtml</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
        </auth-constraint>
    </security-constraint>
    <security-role>
        <role-name>BASIC</role-name>
    </security-role>
    <security-role>
        <role-name>ADMIN</role-name>
    </security-role>

    <!-- protected-views のトークンが無いときの ProtectedViewException は、Payara の既定のエラー画面
         (例外の内容) ではなく、理由を示す画面にする。状態コードは 500 のまま -->
    <error-page>
        <exception-type>jakarta.faces.application.ProtectedViewException</exception-type>
        <location>/errors/protected-view.html</location>
    </error-page>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <name>SECURITY_FACES_SESSION</name>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
</web-app>
