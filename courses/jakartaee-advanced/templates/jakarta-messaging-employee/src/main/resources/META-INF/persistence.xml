<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.2"
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                        https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd">

    <persistence-unit name="producerPU" transaction-type="JTA">
        <!-- payara/post-boot-commands.asadmin が登録する、同梱の HSQLDB のインメモリ DB -->
        <jta-data-source>jdbc/HsqldbDS</jta-data-source>
        <class>pro.kensait.jakartaee.employee.entity.Employee</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <!-- デプロイのたびに META-INF/sql のスクリプトでテーブルを作り直し、初期データを入れる
                 （sql/hsqldb の SQL を、build.gradle の flattenSql が 1 行 1 文にして WAR に入れる） -->
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <property name="jakarta.persistence.schema-generation.create-source" value="script"/>
            <property name="jakarta.persistence.schema-generation.drop-source" value="script"/>
            <property name="jakarta.persistence.schema-generation.drop-script-source" value="META-INF/sql/1_EMPLOYEE_DROP.sql"/>
            <property name="jakarta.persistence.schema-generation.create-script-source" value="META-INF/sql/2_EMPLOYEE_DDL.sql"/>
            <property name="jakarta.persistence.sql-load-script-source" value="META-INF/sql/3_EMPLOYEE_DML.sql"/>
            <property name="eclipselink.target-database" value="org.eclipse.persistence.platform.database.HSQLPlatform"/>
            <!-- HSQLDB の SA（パスワードなし）で接続する。指定しないと接続プールが資格情報を求めて失敗する -->
            <property name="jakarta.persistence.jdbc.user" value="SA"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
        </properties>
    </persistence-unit>
</persistence>
