<?xml version="1.0" encoding="UTF-8"?>
<!-- すべてのクラスを CDI の走査の対象にする
     Payara の場合、@RegisterRestClient のインタフェース（EmployeeApiClient）は、bean-discovery-mode="all" のときだけ
     @Inject @RestClient で注入できる Bean になる -->
<beans xmlns="https://jakarta.ee/xml/ns/jakartaee"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/beans_4_1.xsd"
       version="4.1" bean-discovery-mode="all">
</beans>
