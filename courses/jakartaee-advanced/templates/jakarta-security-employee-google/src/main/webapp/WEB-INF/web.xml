<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
         version="6.1">

    <!-- 社員の参照は認証済みの利用者なら誰でも、登録・更新・削除は ADMIN だけ（チャプター4.1と同じ） -->
    <!-- Google 版のグループは BASIC だけなので、変更操作は誰にも許可されない -->
    <!-- /login は保護して、未ログインなら OIDC のログインを始めさせる。/callback と /api/logout には制約を書かない -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>employee-read</web-resource-name>
            <url-pattern>/api/employees/*</url-pattern>
            <url-pattern>/api/session</url-pattern>
            <url-pattern>/login</url-pattern>
            <http-method>GET</http-method>
        </web-resource-collection>
        <auth-constraint>
            <role-name>**</role-name>
        </auth-constraint>
    </security-constraint>
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>employee-write</web-resource-name>
            <url-pattern>/api/employees/*</url-pattern>
            <http-method>POST</http-method>
            <http-method>PUT</http-method>
            <http-method>DELETE</http-method>
        </web-resource-collection>
        <auth-constraint>
            <role-name>ADMIN</role-name>
        </auth-constraint>
    </security-constraint>
    <deny-uncovered-http-methods/>
    <security-role>
        <role-name>BASIC</role-name>
    </security-role>
    <security-role>
        <role-name>ADMIN</role-name>
    </security-role>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <!-- チャプター4.1のアプリケーションとは別の名前にして、同じホストでも認証状態を混ぜない -->
            <name>GOOGLE_SESSION</name>
            <!-- React 画面（5173）から Vite の転送で /api を呼ぶとき、同じ localhost の Cookie として送られるように / にする -->
            <path>/</path>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
</web-app>
