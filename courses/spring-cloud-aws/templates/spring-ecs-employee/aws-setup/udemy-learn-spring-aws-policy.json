{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CourseServiceManagement",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:*",
        "rds:*",
        "ecr:*",
        "ecs:*",
        "logs:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcsNetworkSetup",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadCourseExecutionRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::*:role/ecsTaskExecutionRole"
    },
    {
      "Sid": "PassCourseExecutionRoleToEcsTasks",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/ecsTaskExecutionRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "GetCallerIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
