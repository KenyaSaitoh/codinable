<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
  <settings>
    <setting name="mapUnderscoreToCamelCase" value="true" />
    <setting name="logImpl" value="STDOUT_LOGGING"/>
  </settings>
  <typeAliases>
    <typeAlias alias="Employee" type="pro.kensait.mybatis.company.dto.Employee" />
  </typeAliases>
  <typeHandlers>
    <typeHandler handler="org.apache.ibatis.type.EnumOrdinalTypeHandler"
                 javaType="pro.kensait.mybatis.company.type.JobType" />
  </typeHandlers>
  <environments default="development">
    <environment id="development">
      <transactionManager type="JDBC"/>
      <dataSource type="POOLED">
        <property name="driver"
                  value="org.hsqldb.jdbc.JDBCDriver" />
        <!-- Codinable では HSQLDB サーバーを使わずインメモリで動かす
             （元: jdbc:hsqldb:hsql://localhost:9001/testdb。実行のたびに sql/hsqldb の SQL で初期化する） -->
        <property name="url"
                  value="jdbc:hsqldb:mem:testdb" />
        <property name="username"
                  value="SA" />
        <property name="password"
                  value="" />
      </dataSource>
    </environment>
  </environments>
  <mappers>
    <mapper resource="mybatis-mapper.xml" />
    <mapper resource="mybatis-mapper-flat.xml" />
    <mapper resource="mybatis-mapper-join.xml" />
    <mapper resource="mybatis-mapper-nest.xml" />
  </mappers>
</configuration>
