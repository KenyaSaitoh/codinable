<!DOCTYPE html>
<!-- EJS のテンプレート。<%= %> が値の埋め込み、<% %> が JavaScript の文。
     Thymeleaf / Django Template Language と書き方は違うが、役割は同じ。 -->
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>計算アプリケーション (Express)</title>
</head>
<body>
  <h2>計算アプリケーション (Express)</h2>
  <hr>

  <% if (error) { %>
  <div style="color: red"><%= error %></div>
  <% } %>

  <form method="POST" action="/calc">
    <div>
      <span>パラメータ1</span>
      <input type="text" name="param1">
    </div>
    <div>
      <span>パラメータ2</span>
      <input type="text" name="param2">
    </div>
    <div>
      <!-- 押したボタンの value が operator として送られる -->
      <button type="submit" name="operator" value="add">足し算</button>
      <button type="submit" name="operator" value="subtract">引き算</button>
      <button type="submit" name="operator" value="multiply">掛け算</button>
      <button type="submit" name="operator" value="divide">割り算</button>
    </div>
  </form>
</body>
</html>
