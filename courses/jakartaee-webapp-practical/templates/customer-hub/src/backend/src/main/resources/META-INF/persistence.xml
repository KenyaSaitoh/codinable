<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                        https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="bookstorePU" transaction-type="JTA">
        <jta-data-source>jdbc/HsqldbDS</jta-data-source>

        <!-- エンティティクラスは自動スキャンされます -->
        
        <properties>
            <!-- Codinable: デプロイのたびに META-INF/sql のスクリプトでテーブルを作り直し、初期データを入れる
                 (データソースは同梱の HSQLDB のインメモリ DB。payara/post-boot-commands.asadmin で登録する) -->
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <property name="jakarta.persistence.schema-generation.create-source" value="script"/>
            <property name="jakarta.persistence.schema-generation.drop-source" value="script"/>
            <property name="jakarta.persistence.schema-generation.drop-script-source" value="META-INF/sql/1_CUSTOMER_HUB_DROP.sql"/>
            <property name="jakarta.persistence.schema-generation.create-script-source" value="META-INF/sql/2_CUSTOMER_HUB_DDL.sql"/>
            <property name="jakarta.persistence.sql-load-script-source" value="META-INF/sql/3_CUSTOMER_HUB_DML.sql"/>

            <!-- EclipseLink固有の設定 -->
            <property name="eclipselink.target-database" value="org.eclipse.persistence.platform.database.HSQLPlatform"/>
            <property name="eclipselink.logging.level" value="FINE"/>

            <!-- HSQLDB SA user credentials (no password) -->
            <property name="eclipselink.jdbc.user" value="SA"/>
            <property name="eclipselink.jdbc.password" value=""/>
        </properties>
    </persistence-unit>
</persistence>
