# このファイルを .env という名前でコピーし、Google Cloud で作成した自分の OAuth クライアントの値を書く
# アプリの起動時に読み込まれる（application.yml の spring.config.import で指定している。環境変数があればそちらが優先される）
# .env は秘密の値を含むので、他人に渡したり Git に登録したりしない
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# 接続先を変えるときだけ指定する（既定値は application.yml を参照）
# GOOGLE_REDIRECT_URI=http://localhost:8084/login/oauth2/code/google
# FRONTEND_URL=http://localhost:5173
