<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="pro.kensait.spring.employee.mapper.JobMapper">
  <select id="findAll" resultType="pro.kensait.spring.employee.entity.Job">
    SELECT JOB_ID, JOB_NAME, GRADE FROM JOB ORDER BY GRADE
  </select>

  <select id="findById" resultType="pro.kensait.spring.employee.entity.Job">
    SELECT JOB_ID, JOB_NAME, GRADE FROM JOB WHERE JOB_ID = #{jobId}
  </select>
</mapper>
