<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
  <timestamp key="LOG_DATE" datePattern="yyyyMMdd"/>

  <property name="LOG_FILE_NAME" value="spring_mvc_calc_4.log" />
  <appender name="LOG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} ${LOG_LEVEL_PATTERN:-%5p} %X{localhost:-} ${PID:-} --- [ThreadId:%X{threadId}][%t] %-40.40logger{39} : %m%n
      </pattern>
    </encoder>
    <file>${LOG_FILE_NAME}</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_FILE_NAME}.%d{yyyyMMdd}</fileNamePattern>
      <maxHistory>5</maxHistory>
    </rollingPolicy>
  </appender>

  <root>
    <appender-ref ref="LOG_FILE" />
    <appender-ref ref="CONSOLE" />
  </root>
</configuration>