{
  "name": "codinable",
  "version": "202609.01.00",
  "description": "Codinable - Desktop development environment for Udemy courses (Java / Spring Boot / JUnit / SQL / Python / Node.js / static web)",
  "main": "src/main.js",
  "scripts": {
    "build:editor": "node builder/build-editor.js",
    "start": "npm run build:editor && electron .",
